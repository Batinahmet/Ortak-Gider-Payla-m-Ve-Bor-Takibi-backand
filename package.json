{
  "name": "ortak-gider-backend",
  "version": "1.0.0",
  "description": "Ortak gider paylaşımı ve borç takibi API'si",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "seed:reset": "node --env-file-if-exists=.env db/seed.js --reset",
    "seed:dump": "node db/seed.js --dump=db/ornek-veri.sql",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
