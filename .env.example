# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldur. ".env" Git'e eklenmez.
PORT=3000

# Frontend'in çalıştığı adres (CORS için). Birden fazlaysa virgülle ayır.
CORS_ORIGIN=http://localhost:5173

# SQLite dosya yolu (varsayılan: data/ortak-gider.db)
DB_PATH=data/ortak-gider.db

# Oturum geçerlilik süresi (gün). Süresi dolan oturumlar otomatik silinir. Varsayılan: 7
SESSION_DAYS=7

# Fiş okuma ve borç özeti için Anthropic API anahtarı.
# Boş bırakırsan yapay zeka uçları kapalı kalır, uygulamanın geri kalanı çalışır.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
